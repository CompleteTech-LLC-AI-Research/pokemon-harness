# ROM and build-derived game artifacts — never commit (BYO-ROM, see README)
*.gb
*.gbc
*.sym
*.map
*.sav
*.state
rom/
roms/
pokered/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/

# Walkthrough artifacts (derived from ROM — never commit)
walkthrough_output/
walkthrough_*/

# Production-gate reports and ROM-derived diagnostics
.production-gate/
production_gate_output/
artifacts/

# Tooling
.idea/
.vscode/
*.swp
.DS_Store

# Non-Cython PyBoy venv.
.venv-noncython/

# The harness ships the exact patched PyBoy source used by the link runtime.
# Keep all other vendor material ignored; the source tree itself is explicitly
# allow-listed below so a clean checkout can install it without PYTHONPATH.
vendor/*
!vendor/pyboy-src/
!vendor/pyboy-src/**
